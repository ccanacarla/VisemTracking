    "import pandas as pd\n",
    "\n",
    "# Lendo o CSV\n",
    "df = pd.read_csv(\"symbolic.csv\")\n",
    "\n",
    "# Criando trajectory_id sequencial\n",
    "df[\"trajectory_id\"] = [f\"traj_{i}\" for i in range(1, len(df) + 1)]\n",
    "\n",
    "# Salvando novamente (opcional)\n",
    "df.to_csv(\"symbolic2.csv\", index=False)\n"
   ]
  }
